# Copy to .env (`cp .env.example .env`). Prisma CLI, Next.js and the seed script all read it.
# Put personal overrides in .env.local (git-ignored, takes precedence in Next.js).
# Optional variables are commented out: leave them unset rather than empty.

# --- Database (required) ---
# Local Postgres via `docker compose up -d`:
DATABASE_URL="postgresql://planify:planify@localhost:5432/planify"

# --- Auth.js (required) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# This email is promoted to ADMIN on login (unlocks /admin)
# ADMIN_EMAIL=you@example.com

# --- AI provider (at least one key required to generate plans) ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# "openai" | "anthropic". If unset: Anthropic when its key is present, else OpenAI.
# AI_PROVIDER=anthropic
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_REASONING_EFFORT=low
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Optional sign-in providers (enabled automatically when set) ---
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_RESEND_KEY=            # magic link + password-reset emails
# EMAIL_FROM="Planify <onboarding@resend.dev>"

# --- Demo seed (optional) ---
# SEED_EMAIL=demo@planify.health
# SEED_PASSWORD=planify123
